{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servir currículo",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/serve.ps1\"",
      "isBackground": true,
      "problemMatcher": {
        "owner": "cv-server",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
